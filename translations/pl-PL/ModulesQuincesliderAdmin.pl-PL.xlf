        <target>Kolor</target>
      </trans-unit>
      <trans-unit id="quince.slider.bg_colour_hint">
        <source>A step of the shop palette (neutral, primary, secondary, promo) from 1 to 12, or a hex code.</source>
        <target>Stopień palety sklepu (neutral, primary, secondary, promo) od 1 do 12 albo kod hex.</target>
