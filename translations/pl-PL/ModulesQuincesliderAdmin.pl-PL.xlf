        <source>Background</source>
        <target>Tło</target>
      </trans-unit>
      <trans-unit id="quince.slider.bg_desc">
        <source>A colour, a gradient, a photo or a video. Each one has its own fields.</source>
        <target>Kolor, gradient, zdjęcie albo wideo. Każde z nich ma własne pola.</target>
      </trans-unit>
      <trans-unit id="quince.slider.bg_kind">
        <source>Kind</source>
        <target>Rodzaj</target>
      </trans-unit>
      <trans-unit id="quince.slider.bg_colour">
