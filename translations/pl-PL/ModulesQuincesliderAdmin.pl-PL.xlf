      <!-- Ekran -->
      <trans-unit id="quince.slider.intro">
        <source>A slide has three things that do not depend on each other: a background, a content layout and the content itself. The band appears wherever the home page puts the slider hook.</source>
        <target>Slajd składa się z trzech niezależnych od siebie części: tła, układu treści i samej treści. Pas pojawia się tam, gdzie strona główna ma hook slidera.</target>
      </trans-unit>

      <!-- Karta: pas -->
      <trans-unit id="quince.slider.band">
        <source>The band</source>
        <target>Pas</target>
      </trans-unit>
      <trans-unit id="quince.slider.height">
        <source>Height</source>
        <target>Wysokość</target>
      </trans-unit>
      <trans-unit id="quince.slider.width">
        <source>Width</source>
        <target>Szerokość</target>
      </trans-unit>
      <trans-unit id="quince.slider.interval">
        <source>Seconds per slide</source>
        <target>Sekundy na slajd</target>
      </trans-unit>
      <trans-unit id="quince.slider.interval_hint">
        <source>Only matters when the band moves on its own.</source>
        <target>Ma znaczenie tylko wtedy, gdy pas przewija się sam.</target>
      </trans-unit>
      <trans-unit id="quince.slider.autoplay">
        <source>Moves on its own</source>
        <target>Przewija się sam</target>
      </trans-unit>
      <trans-unit id="quince.slider.arrows">
        <source>Arrows</source>
        <target>Strzałki</target>
      </trans-unit>
      <trans-unit id="quince.slider.dots">
