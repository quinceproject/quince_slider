        <target>Przyciemnij cały slajd</target>
      </trans-unit>
      <trans-unit id="quince.slider.bg_shade_hint">
        <source>For a photo that fights with the text.</source>
        <target>Dla zdjęcia, które gryzie się z tekstem.</target>
      </trans-unit>

