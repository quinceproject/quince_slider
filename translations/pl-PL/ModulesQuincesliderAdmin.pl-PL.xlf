        <target>bez nagłówka</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.slide">
        <source>Slide</source>
        <target>Slajd</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.claims">
        <source>claims</source>
        <target>haseł</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.buttons">
        <source>buttons</source>
        <target>przycisków</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.video">
        <source>video</source>
        <target>wideo</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.photo">
        <source>photo</source>
        <target>zdjęcie</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.gradient">
        <source>gradient</source>
        <target>gradient</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.colour">
        <source>colour</source>
        <target>kolor</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.panel">
        <source>in a panel</source>
        <target>w panelu</target>
      </trans-unit>
      <trans-unit id="quince.slider.sum.centred">
