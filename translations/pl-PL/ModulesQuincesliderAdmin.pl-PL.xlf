    <body>

      <!-- Moduł -->
      <trans-unit id="quince.slider.name">
        <source>Quince slider</source>
        <target>Quince: slider</target>
      </trans-unit>
      <trans-unit id="quince.slider.description">
        <source>A band of slides for the top of the page: colour, gradient, photo or video.</source>
        <target>Pas slajdów na górę strony: kolor, gradient, zdjęcie albo wideo.</target>
      </trans-unit>
      <trans-unit id="quince.slider.uninstall">
        <source>Uninstall the module? The slides will be removed.</source>
        <target>Odinstalować moduł? Slajdy zostaną usunięte.</target>
      </trans-unit>
      <trans-unit id="quince.slider.nav">
        <source>Slider</source>
        <target>Slider</target>
      </trans-unit>
      <trans-unit id="quince.slider.csrf">
        <source>Invalid security token, please try again.</source>
        <target>Nieprawidłowy token bezpieczeństwa, spróbuj ponownie.</target>
      </trans-unit>
      <trans-unit id="quince.slider.saved">
        <source>Settings saved.</source>
        <target>Ustawienia zapisane.</target>
      </trans-unit>
      <trans-unit id="quince.slider.save">
        <source>Save changes</source>
        <target>Zapisz zmiany</target>
      </trans-unit>

