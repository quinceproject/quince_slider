      <trans-unit id="quince.slider.slides">
        <source>Slides</source>
        <target>Slajdy</target>
      </trans-unit>
      <trans-unit id="quince.slider.add_slide">
        <source>Add a slide</source>
        <target>Dodaj slajd</target>
      </trans-unit>
      <trans-unit id="quince.slider.empty">
        <source>No slides yet. The band stays hidden until you add one.</source>
        <target>Nie ma jeszcze slajdów. Pas pozostaje ukryty, dopóki nie dodasz pierwszego.</target>
      </trans-unit>
      <trans-unit id="quince.slider.drag">
        <source>Drag to reorder</source>
        <target>Przeciągnij, aby zmienić kolejność</target>
      </trans-unit>
      <trans-unit id="quince.slider.settings">
        <source>Settings</source>
        <target>Ustawienia</target>
      </trans-unit>
      <trans-unit id="quince.slider.remove">
        <source>Remove</source>
        <target>Usuń</target>
      </trans-unit>

